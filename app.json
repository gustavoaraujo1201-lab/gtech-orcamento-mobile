{
  "expo": {
    "name": "Gtech Orçamento Mobile",
    "slug": "gtech-orcamento-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/images/icon/app-icon.png",
    "splash": {
      "image": "./assets/images/icon/app-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B0F1A"
    },
    "android": {
      "package": "com.gtechprime.orcamento",
      "versionCode": 2,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon/app-icon-adaptive-foreground.png",
        "backgroundColor": "#0B0F1A"
      }
    },
    "ios": {
      "bundleIdentifier": "com.gtechprime.orcamento"
    },
    "plugins": [
      "expo-asset",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "buildToolsVersion": "36.0.0"
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "4058ffb4-6b55-4247-88c2-b19317ba399d"
      }
    },
    "owner": "gustavoaraujo12"
  }
}
